{
  "expo": {
    "name": "Speak2Sign",
    "slug": "Speak2Sign",
    "version": "1.1.0",
    "scheme": "speak2sign",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2b2d2e",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.speak2sign",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "./plugins/withAndroidProcessText",
      "onnxruntime-react-native",
      "./plugins/withOnnxruntimePackageRegistration",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Permitir que o Speak2Sign use a câmera para reconhecer letras em Libras.",
          "enableMicrophonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permitir que o Speak2Sign use o microfone para reconhecimento de voz.",
          "speechRecognitionPermission": "Permitir que o Speak2Sign use o reconhecimento de fala.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4bb680ee-edfa-4241-900f-c4c59c42f81a"
      }
    }
  }
}
