{
  "name": "frontend",
  "version": "1.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:default": "expo start",
    "android": "expo run:android",
    "android:build:arm64": "expo prebuild --platform android --no-install && cd android && gradlew assembleDebug --console=plain -PreactNativeArchitectures=arm64-v8a",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package && node scripts/fixarCmakeVisionCamera.js"
  },
  "dependencies": {
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.5",
    "@speak2sign/react-native-mediapipe-hands": "file:packages/react-native-mediapipe-hands",
    "axios": "^1.13.6",
    "expo": "~55.0.15",
    "expo-asset": "^55.0.17",
    "expo-build-properties": "~1.0.0",
    "expo-font": "~55.0.6",
    "expo-speech-recognition": "^3.1.2",
    "expo-status-bar": "~55.0.5",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.2.0",
    "react-native": "0.83.4",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "4.7.2",
    "react-native-webview": "13.16.0",
    "react-native-worklets-core": "1.6.3"
  },
  "devDependencies": {
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-transform-template-literals": "^7.29.7",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^55.0.21",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "private": true
